rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: users
// Document ID: {userId} (Firebase Auth UID)
// Fields:
//   - user_id: string (required, immutable, matches {userId} and request.auth.uid)
//   - email: string (required, max 254 chars) - user email address
//   - fullname: string (required, max 200 chars) - display name
//   - role: string (required, enum: ['secretary', 'dean', 'staff']) - workspace role
//   - createdAt: string/timestamp (optional) - creation timestamp
//   - updatedAt: string/timestamp (optional) - last update timestamp
//
// Collection: roleAssignments
// Document ID: {roleId} (one of 'secretary', 'dean', 'staff')
// Fields:
//   - user_ids: list<string> (required, max 50 items, must include request.auth.uid on write)
//   - updatedAt: string/timestamp (optional) - last update timestamp
//
// Collection: requests
// Document ID: {requestId}
// Fields:
//   - id: string (required, max 128 chars) - request tracking ID (e.g. REQ-... or INC-...)
//   - direction: string (optional, 'outgoing' | 'incoming')
//   - student: string (optional) - requester or sender name
//   - document: string (optional) - document/form title
//   - status: string (optional) - workflow status
//   - office: string (optional) - office or department
//   - category: string (optional) - document category
//   - history: list (optional) - status audit trail
//
// Collection: tasks
// Document ID: {taskId}
// Fields:
//   - id: string (required, max 128 chars) - task ID
//   - title: string (required) - task description/title
//   - priority: string (optional) - Low / Medium / High / Top
//   - status: string (optional) - Not started / In progress / Done
//   - done: bool (optional) - completion flag
//   - due: string (optional) - ISO date string
//
// Collection: inventory
// Document ID: {itemId}
// Fields:
//   - id: string (required, max 128 chars) - inventory item ID
//   - productId: string (optional) - formatted product code (e.g. PRD-0001)
//   - name: string (required) - item name
//   - category: string (optional) - supply/equipment category
//   - quantity: number (required) - current stock balance
//   - unit: string (optional) - unit of measure
//   - usageType: string (optional) - Borrow / Use
//
// Collection: inventoryRecords
// Document ID: {recordId}
// Fields:
//   - id: string (required, max 128 chars) - transaction record ID (e.g. REC-...)
//   - productId: string (required) - associated product code
//   - productName: string (optional) - item name snapshot
//   - status: string (required) - Borrowed / Returned / Used
//   - quantity: number (required) - transaction quantity
//   - person: string (optional) - borrower/user name
//   - dateTime: string (optional) - ISO timestamp
//
// Collection: workspaceSettings
// Document ID: {settingId}
// Fields:
//   - departmentName: string (optional)
//   - collegeName: string (optional)
//   - officeLocation: string (optional)
//   - contactEmail: string (optional)
//   - sidebarDefault: string (optional)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidRole(role) {
      return role in ['secretary', 'dean', 'staff'];
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == null ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }

    function isValidList(listData, maxSize) {
      return listData is list && listData.size() <= maxSize;
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update rules)
    // ===============================================================

    function isValidUser(data, userId) {
      return hasRequiredFields(['user_id', 'email', 'fullname', 'role']) &&
             data.user_id is string &&
             data.user_id == userId &&
             validStringLength('email', 3, 254) &&
             validStringLength('fullname', 1, 200) &&
             isValidRole(data.role) &&
             isValidOptionalString('createdAt', 1, 64) &&
             isValidOptionalString('updatedAt', 1, 64);
    }

    function isValidRoleAssignment(data, roleId) {
      return isValidRole(roleId) &&
             hasRequiredFields(['user_ids']) &&
             isValidList(data.user_ids, 50) &&
             request.auth.uid in data.user_ids &&
             isValidOptionalString('updatedAt', 1, 64);
    }

    function isValidWorkspaceDocument(data) {
      return data is map &&
             data.keys().size() >= 1 &&
             data.keys().size() <= 60 &&
             isValidOptionalString('id', 1, 128);
    }

    // ===============================================================
    // Collection Security Rules
    // ===============================================================

    // 1. Users Collection
    // Pre-signup role capacity query in authService.js requires public read access.
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId) &&
                       isValidUser(request.resource.data, userId) &&
                       request.resource.data.user_id == resource.data.user_id;
      allow delete: if isOwner(userId);
    }

    // 2. Role Assignments Collection
    // Tracks assigned UIDs per role ('secretary', 'dean', 'staff') during registration transactions.
    match /roleAssignments/{roleId} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
                               isValidRoleAssignment(request.resource.data, roleId);
      allow delete: if false;
    }

    // 3. Document Tracker Requests Collection (Outgoing & Incoming)
    match /requests/{requestId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                               isValidWorkspaceDocument(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // 4. Task Management Collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                               isValidWorkspaceDocument(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // 5. Supply & Inventory Masterlist Collection
    match /inventory/{itemId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                               isValidWorkspaceDocument(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // 6. Supply & Inventory Borrow/Use/Return Records & Digital Receipts
    match /inventoryRecords/{recordId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                               isValidWorkspaceDocument(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // 7. Workspace & Office Settings Collection
    match /workspaceSettings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
                               isValidWorkspaceDocument(request.resource.data);
      allow delete: if false;
    }

    // Default Deny All Other Paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
